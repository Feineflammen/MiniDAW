// Versionsangaben der Programmdatei (sichtbar unter Eigenschaften > Details).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0, 6, 0, 0
PRODUCTVERSION 0, 6, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName", "Feineflammen"
            VALUE "FileDescription", "MiniDAW"
            VALUE "FileVersion", "0.6.0.0"
            VALUE "InternalName", "minidaw"
            VALUE "OriginalFilename", "minidaw.exe"
            VALUE "ProductName", "MiniDAW"
            VALUE "ProductVersion", "0.6.0.0"
            VALUE "LegalCopyright", "Hobbyprojekt, Quellcode: github.com/Feineflammen/daw"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
